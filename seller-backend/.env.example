# --- Supabase (same database as the buyer service) --------------------------
SUPABASE_DB_HOST=db.YOUR_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=paste-it-raw-here
SUPABASE_DB_NAME=postgres
DB_SSL=require

# --- App ---------------------------------------------------------------------
JWT_SECRET=seller-secret-change-me
CORS_ORIGINS=http://localhost:5174

# --- The other service -------------------------------------------------------
BUYER_SERVICE_URL=http://localhost:8001
INTERNAL_SECRET=shared-secret-both-services-must-match

# --- Sarvam AI (voice) -------------------------------------------------------
# Leave blank to turn voice off; the portal falls back to typing.
SARVAM_API_KEY=

# --- Demo scope --------------------------------------------------------------
# Login dropdown shows only the suppliers for these products. Blank = all 18.
PORTAL_PRODUCTS=5005
