# --- Supabase (same database as the seller service) -------------------------
SUPABASE_DB_HOST=db.YOUR_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=paste-it-raw-here
SUPABASE_DB_NAME=postgres
DB_SSL=require

# --- DeepInfra ---------------------------------------------------------------
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# --- Bright Data SERP --------------------------------------------------------
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
SERP_CACHE_TTL_HOURS=24

# --- Business ----------------------------------------------------------------
LOCATION=Mumbai, India
NUMBER_OF_STORES=1
TOTAL_INVENTORY_CAPACITY=125
MAX_NEGOTIATION_ROUNDS=3
SIMULATED_TODAY=2025-07-15

# --- App ---------------------------------------------------------------------
JWT_SECRET=buyer-secret-change-me
CORS_ORIGINS=http://localhost:5173

# --- The other service -------------------------------------------------------
SELLER_SERVICE_URL=http://localhost:8002
INTERNAL_SECRET=shared-secret-both-services-must-match

# --- Cognee Cloud (negotiation memory) ---------------------------------------
# From the API Keys page at platform.cognee.ai. The URL is your own tenant.
# Leave both blank to turn the memory off.
COGNEE_API_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=

# --- Demo scope --------------------------------------------------------------
# Only these products are analysed by the agents. Blank = all six.
ONLY_PRODUCTS=
# The 24h background Stock Watch. The console button works either way.
DAILY_CHECK_ENABLED=false
